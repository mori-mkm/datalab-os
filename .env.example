# Copy to .env (optional). Every value below is the default.

# Ollama (local LLM). "auto" = use it if reachable, otherwise fall back to a
# clearly-labelled deterministic text. "off" = never call it.
DATALAB_LLM=auto
DATALAB_OLLAMA_URL=http://127.0.0.1:11434
DATALAB_OLLAMA_MODEL=qwen3:8b

# Visual pacing (seconds) so handoffs / demo steps are observable in the UI.
DATALAB_HANDOFF_DELAY=0.6
DATALAB_DEMO_DELAY=0.8

# Comma-separated origins allowed to call the API from a browser.
DATALAB_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
